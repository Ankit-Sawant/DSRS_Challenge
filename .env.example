# Copy to .env and fill in. .env is gitignored -- never commit credentials.
#
# agents/llm.py reads these. Any OpenAI-compatible endpoint works: Ollama, LM Studio,
# vLLM, llama.cpp. Point it at whatever you can run locally.
#
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1
#   LM Studio:  LLM_BASE_URL=http://localhost:1234/v1
#   vLLM:       LLM_BASE_URL=http://localhost:8000/v1
#
# At grading time we replace this file with our own. Your agent runs against our
# endpoint with no code change -- which only works if you keep configuration here
# rather than in your code.

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-required

# Leave blank to auto-discover from the endpoint. We serve exactly one model, so blank
# works at grading time too.
LLM_MODEL=

# "mock" returns deterministic canned responses and contacts no endpoint -- use it to
# run your tests without a model.
LLM_MODE=live

# Enforced at grading time. Your agent should stay well under it.
LLM_TOKEN_BUDGET=2000000
